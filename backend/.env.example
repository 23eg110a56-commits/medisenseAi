# MediSense AI backend configuration
#
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# Every value below is a placeholder — none of them are real credentials.

# --- Application -----------------------------------------------------------
PROJECT_NAME="MediSense AI"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"

# Comma-separated list of origins allowed to call the API from a browser.
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Security --------------------------------------------------------------
# REQUIRED in any deployment that is reachable by other people. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left blank the server generates an ephemeral key at startup and logs a
# warning; every session is then invalidated on restart.
SECRET_KEY=""

ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional administrator bootstrap. Leave ADMIN_PASSWORD blank to skip creating
# an admin account entirely. Do not reuse a password from anywhere else.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Upload limits ---------------------------------------------------------
# Maximum size accepted per report file, in megabytes. Allowed types are fixed
# to PDF, PNG, JPG and JPEG.
MAX_UPLOAD_SIZE_MB=10

# --- Datastore -------------------------------------------------------------
# MongoDB is used when reachable. If it is not, the server falls back to an
# embedded JSON store under ./data and logs which mode it is in.
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="medisense_ai"

# PostgreSQL configuration (optional for enterprise relational storage & migrations)
# Run migrations with: python scripts/migrate_postgres.py or alembic upgrade head
POSTGRES_URL=""

# --- AI model (optional) ---------------------------------------------------
# Leave blank to run in honest degraded mode: reports are then analysed by the
# rule-based reader, which only reports values actually printed in the document,
# and the chat assistant returns retrieved evidence instead of generated text.
# The UI states this to the user rather than passing fallback output off as AI.
GEMINI_API_KEY=""
# Model identifier used when a key is present. Blank means the built-in default
# (gemini-2.5-flash).
GEMINI_MODEL=""

# --- Development only ------------------------------------------------------
# When true, password-reset codes are returned in the API response instead of
# being emailed. This bypasses email verification: keep it false anywhere the
# service is reachable by other people.
EXPOSE_DEV_OTP=false
